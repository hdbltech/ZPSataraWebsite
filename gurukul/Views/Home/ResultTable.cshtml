@using (Html.BeginForm("ResultTable", "Home"))
{

    <section id="pricing">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 col-lg-offset-3">
                    <h3>दि. २१/०४/२०२५ रोजी प्रसिद्ध होणार्‍या निकाला संदर्भात सूचना</h3>
                    <ul style="text-align: left; list-style-type: none;">
                        <li style="color:black;"><b>१.</b> हा निकाल अंतिम आहे </li>
                        <li style="color:black;"><b>२.</b> निकालासंदर्भात हरकत असलेस मुख्य कार्यालयाशी पत्राद्वारे कळवावे, फोने वरून हरकती स्वीकारल्या जाणार नाहीत. कार्यालयाचा पत्ता -प्लॉट नं ३१/३२, वृंदावन पार्क, एस. एस.सी.बोर्ड जवळ, ५२६/४, ई वॉर्ड, कोल्हापूर, ४१६००८</li>
                        <li style="color:black;"><b>३.</b> इसरो संदर्भात विद्यार्थ्यांची यादी लवकरच प्रसिद्ध करणेत येईल </li>
                    </ul>
                </div>
            </div>
            <div class="row">
                <div class="col-md- col-sm-2 col-xs-12 wow fadeInUp img-responsive container" style="color:gainsboro" data-wow-duration="200ms">

                </div>

                <div class="col-md-8 col-sm-8 col-xs-12 wow fadeInUp img-responsive container" style="color:gainsboro" data-wow-duration="200ms">

                    @if (Model.standard == 1 || Model.standard == 2)
                    {
                        <img class="imgmarksheet" src="~/images/english12.jpg" />
                        <div class="student-Name1">@Model.Name</div>
                        <div class="Taluka-Name1">@Model.Taluka</div>
                        <div class="Dist-Name1">@Model.dist</div>
                        if (Model.standard == 1)
                        { <div class="standard1">1st</div> }
                        if (Model.standard == 2)
                        { <div class="standard1">2nd</div> }
                        <div class="Marks1">@Model.Marks1</div>
                        <div class="Total2">@Model.Total</div>
                        <div class="outOff1">100</div>
                        <div class="Percentage2">@Model.Percentage%</div>
                        <div class="schoolName1">@Model.schoolname</div>
                        <div class="rank111">@Model.TalukaRank</div>
                        <div class="rank211">@Model.DistaRank</div>
                        <div class="rank311">@Model.StateRank</div>
                    }
                    else
                    {
                        <img class="imgmarksheet" src="~/images/english38.jpg" />
                        <div class="student-Name">@Model.Name</div>
                        <div class="Taluka-Name">@Model.Taluka</div>
                        <div class="Dist-Name">@Model.dist</div>
                        if (Model.standard == 3)
                        { <div class="standard">3rd</div> }
                        if (Model.standard == 4)
                        { <div class="standard">4th</div> }
                        if (Model.standard == 5)
                        { <div class="standard">5th</div> }
                        if (Model.standard == 6)
                        { <div class="standard">6th</div>}
                        if (Model.standard == 7)
                        { <div class="standard">7th</div> }
                        if (Model.standard == 8)
                        { <div class="standard">8th</div> }
                        <div class="Marks11">@Model.Marks1</div>
                        <div class="Marks2">@Model.Marks2</div>
                        <div class="Total">@Model.Total</div>
                        <div class="outOff">300</div>
                        <div class="Percentage">@Model.Percentage%</div>
                        <div class="schoolName">@Model.schoolname</div>
                        <div class="rank1">@Model.TalukaRank</div>
                        <div class="rank2">@Model.DistaRank</div>
                        <div class="rank3">@Model.StateRank</div>
                    }
                </div>
            </div>

            <div class="row">
                <h2>सर्व गुणवंत विद्यार्थ्यांचे गुरुकुल प्रज्ञाशोध परीक्षा विभागातर्फे हार्दिक अभिनंदन. पुढील शैक्षणिक वाटचालीसाठी हार्दिक शुभेच्छा</h2>
            </div>
        </div>
    </section>

